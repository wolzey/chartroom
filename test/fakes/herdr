#!/usr/bin/env bash
# fake herdr. Without $FAKE_HERDR_DIR: a server that is not running.
# With it: enough of the CLI for chartroom's herdr runner, state in $FAKE_HERDR_DIR.
#   $S/screen      what every agent shows (default: a prompt box). A trust dialog there makes
#                  `agent start` return agent_not_ready with the name kept, as herdr does;
#                  sending enter clears it.
#   $S/agents/<n>  live agents, "<pane> <tab> <status>"; a leftover one makes start agent_name_taken.
#   $S/panes/<p>   panes `pane list/get/close` know besides agents' (sweep), "<tab> <cwd>".
# `agent prompt` simulates Claude's UserPromptSubmit hook for task $FAKE_HERDR_TASK.
#   $S/machines.json   what `machine list --json` prints (default: none saved)
#   $S/agent-list.json what `agent list` prints (the radar's flagships; without it `agent list` is
#                      unknown, as before); `--machine <m>` reads
#                      $S/machine-<m>/ instead, and `agent read` of a pane listed there shows
#                      the screen; a `hang` file there makes `agent list` never answer
[[ -n "${FAKE_HERDR_DIR:-}" ]] || { echo "herdr: could not connect to server socket" >&2; exit 1; }
S="$FAKE_HERDR_DIR"; mkdir -p "$S/agents"
printf '%s\n' "$*" >>"$S/calls.log"
L="$S" # where `agent list` reads from: this machine, or a saved one (--machine)
if [[ "${1:-}" == --machine ]]; then
  L="$S/machine-${2:-}"; shift 2
  [[ -d "$L" ]] || { echo "herdr: machine is not reachable" >&2; exit 1; }
fi
arg() { local k="$1"; shift; while [[ $# -gt 0 ]]; do [[ "$1" == "$k" ]] && { printf '%s' "$2"; return; }; shift; done; }
err() { printf '{"error":{"code":"%s","message":"%s"},"id":"cli:fake"}\n' "$1" "$2" >&2; exit 1; }
next() { local n; n=$(( $(cat "$S/n" 2>/dev/null || echo 0) + 1 )); echo "$n" >"$S/n"; printf '%s' "$n"; }
screen() { cat "$S/screen" 2>/dev/null || printf '❯ \n'; }
trust_up() { screen | grep -qiE 'trust this folder|do you trust'; }
created() { # <workspace id> -> a fresh tab and root pane
  local n; n="$(next)"
  printf '{"result":{"workspace":{"workspace_id":"%s"},"tab":{"tab_id":"%s:t%s"},"root_pane":{"pane_id":"%s:p%s"}}}\n' "$1" "$1" "$n" "$1" "$n"
}
cmd="${1:-} ${2:-}"; shift 2 || true
case "$cmd" in
  "workspace list")
    if [[ -f "$S/ws" ]]; then printf '{"result":{"workspaces":[{"workspace_id":"w1","label":"%s"}]}}\n' "$(cat "$S/ws")"
    else echo '{"result":{"workspaces":[]}}'; fi ;;
  "workspace create") arg --label "$@" >"$S/ws"; created w1 ;;
  "tab create") created "$(arg --workspace "$@")" ;;
  "tab close") grep -l " $1 " "$S"/agents/* 2>/dev/null | xargs rm -f ;;
  "tab rename"|"tab focus") : ;;
  "agent start")
    [[ -f "$S/agents/$1" ]] && err agent_name_taken "agent name $1 is already in use"
    pane="$(arg --pane "$@")"
    echo "$pane ${pane%:p*}:t${pane##*:p} idle" >"$S/agents/$1"
    trust_up && err agent_not_ready "agent $1 blocked during startup"
    printf '{"result":{"agent":{"name":"%s","pane_id":"%s"}}}\n' "$1" "$pane" ;;
  "agent get")
    [[ -f "$S/agents/$1" ]] || err agent_not_found "agent target $1 not found"
    read -r pane tab st <"$S/agents/$1"
    printf '{"result":{"agent":{"agent_status":"%s","pane_id":"%s","tab_id":"%s"}}}\n' "$st" "$pane" "$tab" ;;
  "agent read")
    [[ -f "$S/agents/$1" ]] || grep -qF "\"$1\"" "$L/agent-list.json" 2>/dev/null || err agent_not_found "agent target $1 not found"
    screen ;;
  "agent list") # only when a test gives one: without it, callers keep their `agent get` fallback (sweep)
    [[ -f "$L/hang" ]] && exec sleep 60 # a herdr that never answers (a dead saved machine)
    [[ -f "$L/agent-list.json" ]] || err unknown "unknown command $cmd"
    cat "$L/agent-list.json" ;;
  "machine list") if [[ -f "$S/machines.json" ]]; then cat "$S/machines.json"; else echo '[]'; fi ;;
  "agent send-keys")
    [[ -f "$S/agents/$1" ]] || err agent_not_found "agent target $1 not found"
    [[ "$2" == enter ]] && trust_up && rm -f "$S/screen" ;;
  "agent prompt")
    [[ -f "$S/agents/$1" ]] || err agent_not_found "agent target $1 not found"
    trust_up && err agent_blocked "agent $1 is waiting at a dialog"
    [[ -n "${FAKE_HERDR_TASK:-}" ]] && jq -cn --arg p "$2" '{prompt:$p}' | "${CHARTROOM_BIN:?}" hook "$FAKE_HERDR_TASK" prompt-submit ;;
  "agent wait") : ;;
  "pane list")
    for f in "$S"/panes/*; do [[ -f "$f" ]] || continue; read -r tab cwd <"$f"
      jq -cn --arg p "$(basename "$f" | tr _ :)" --arg t "$tab" --arg c "$cwd" '{pane_id: $p, tab_id: $t, cwd: $c}'; done |
      jq -s '{result: {panes: .}}' ;;
  "pane get")
    f="$S/panes/${1//:/_}"; [[ -f "$f" ]] || err pane_not_found "pane $1 not found"; read -r tab cwd <"$f"
    jq -cn --arg p "$1" --arg t "$tab" --arg c "$cwd" '{result: {pane: {pane_id: $p, tab_id: $t, cwd: $c}}}' ;;
  "pane close") f="$S/panes/${1//:/_}"; [[ -f "$f" ]] || err pane_not_found "pane $1 not found"; rm -f "$f" ;;
  *) err unknown "unknown command $cmd" ;;
esac
exit 0

#!/usr/bin/env bash
# fake taskkill (Git Bash): logs, and `//PID N` with //F ends process N here.
echo "taskkill $*" >>"${FAKE_LOG:-/dev/null}"
pid="" force=""
while [[ $# -gt 0 ]]; do
  case "$1" in //PID) pid="$2"; shift 2 ;; //F) force=1; shift ;; *) shift ;; esac
done
[[ -n "$pid" ]] || exit 1
if [[ -n "$force" ]]; then kill -9 "$pid" 2>/dev/null; else kill "$pid" 2>/dev/null; fi

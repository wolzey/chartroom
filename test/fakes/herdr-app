#!/usr/bin/env bash
# fake herdr-app: a window that adopts the fake hc's live labelled terminals ($FAKE_HC_DIR),
# as Herdr does: herdr.space=<id> puts one in that space, made if unknown and called after its
# folder until renamed; herdr.tab=<id> gives it that tab, called "1" until renamed.
# Without $FAKE_HERDR_APP_DIR no window answers. State in $FAKE_HERDR_APP_DIR:
#   names/<id>    a space's or tab's name, from space.rename / tab.rename
#   spaces.json   spaces the window already had, [{id, name}]
#   calls.log     every call
[[ -n "${FAKE_HERDR_APP_DIR:-}" ]] || { echo "herdr-app: no Herdr window at /nonexistent/herdr-app.sock" >&2; exit 2; }
A="$FAKE_HERDR_APP_DIR"; mkdir -p "$A/names"
printf '%s\n' "$*" >>"$A/calls.log"
names_json() {
  local f
  for f in "$A"/names/*; do [[ -f "$f" ]] && jq -cn --arg k "${f##*/}" --arg v "$(cat "$f")" '{($k): $v}'; done | jq -s -c 'add // {}'
}
case "${1:-}" in
  ls)
    for f in "${FAKE_HC_DIR:-/nonexistent}"/terms/*.json; do [[ -f "$f" ]] && cat "$f"; done |
      jq -s --argjson pre "$(cat "$A/spaces.json" 2>/dev/null || echo '[]')" --argjson names "$(names_json)" '
        def nm($id; $d): $names[$id] // $d;
        def tabs($ts; $s): [$ts | map(select(.labels["herdr.space"] == $s)) | group_by(.labels["herdr.tab"] // .address)[]
          | (.[0].labels["herdr.tab"] // ("tb-" + .[0].address)) as $tid
          | {id: $tid, name: nm($tid; "1"), terminals: [.[] | {terminal: .address, name}]}];
        [.[] | select(.state == "live" and (.labels["herdr.space"] // "") != "")] as $ts
        | {spaces: ([$pre[] | {id, name: nm(.id; .name), machine: null, tabs: tabs($ts; .id)}]
            + [$ts | map(.labels["herdr.space"]) | unique[] | select(. as $s | ($pre | map(.id) | index($s)) == null)
               | . as $s | {id: $s, name: nm($s; ($ts | map(select(.labels["herdr.space"] == $s))[0].cwd | split("/") | last)),
                            machine: null, tabs: tabs($ts; $s)}])}' ;;
  do)
    c="${2:-}"; shift 2; id="" name=""
    while [[ $# -gt 0 ]]; do
      case "$1" in --id|--terminal) id="$2"; shift 2 ;; --name) name="$2"; shift 2 ;; *) shift 2 ;; esac
    done
    case "$c" in
      space.rename|tab.rename) printf '%s' "$name" >"$A/names/$id" ;;
      agent.focus|tab.close) : ;;
      *) echo '{"error": "unknown command"}'; exit 1 ;;
    esac
    echo '{"ok": true}' ;;
  *) echo "herdr-app: fake: unknown $*" >&2; exit 2 ;;
esac
exit 0

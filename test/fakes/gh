#!/usr/bin/env bash
# fake gh: `gh pr view <url> --json ...` answers from $FAKE_GH_STATES ({url: {...}}).
echo "gh $*" >>"${FAKE_LOG:-/dev/null}"
if [[ "${1:-}" == pr && "${2:-}" == view && -n "${FAKE_GH_STATES:-}" ]]; then
  out="$(jq -ce --arg u "$3" '.[$u]' "$FAKE_GH_STATES" 2>/dev/null)" || { echo "no pull requests found for $3" >&2; exit 1; }
  printf '%s\n' "$out"; exit 0
fi
echo "fake gh: unsupported: $*" >&2; exit 1

#!/usr/bin/env bash
# chartroom - deterministic mechanics for the chartroom skill.
#
# The XO (an agent) owns judgment: what to delegate, to whom, what to tell the
# commander. This script owns everything that can be exact: task records, worktrees,
# launching and steering workers, liveness, and the wake stream. It never decides
# meaning; when the world surprises it, it stops and says so.
#
# State lives in $CHARTROOM_HOME (default ~/.chartroom), never in chat memory:
#   tasks/<id>/meta.json    machine record (schema, project, backend, worktree, handles)
#   tasks/<id>/brief.md     the worker's contract (intent, spec, authority, protocol)
#   tasks/<id>/events.log   append-only "<ts> <kind>: <text>" lines from workers + chartroom
#   tasks/<id>/report.md    the worker's final report
#   rulings.log             append-only commander rulings, latest wins per topic (lib/rulings.sh)
#
# Usage: chartroom <command> [args]   (chartroom help for the list)

if [[ -z "${BASH_VERSINFO:-}" || "${BASH_VERSINFO[0]}" -lt 4 ]]; then
  printf 'chartroom: bash >= 4 required (this is %s). On macOS: brew install bash\n' "${BASH_VERSION:-unknown}" >&2
  exit 1
fi
set -euo pipefail

_self="${BASH_SOURCE[0]}"
if readlink -f / >/dev/null 2>&1; then _self="$(readlink -f "$_self")"
else while [[ -L "$_self" ]]; do _l="$(readlink "$_self")"; [[ "$_l" == /* ]] || _l="$(dirname "$_self")/$_l"; _self="$_l"; done; fi
CR_ROOT="$(cd "$(dirname "$_self")/.." && pwd)"
CR_BIN="$CR_ROOT/bin/chartroom"
# shellcheck source=../lib/core.sh
source "$CR_ROOT/lib/core.sh"
# shellcheck source=../lib/agents.sh
source "$CR_ROOT/lib/agents.sh"
# shellcheck source=../lib/session.sh
source "$CR_ROOT/lib/session.sh"
# shellcheck source=../lib/dashboard.sh
source "$CR_ROOT/lib/dashboard.sh"
# shellcheck source=../lib/rulings.sh
source "$CR_ROOT/lib/rulings.sh"
for _f in "$CR_ROOT"/lib/backends/*.sh; do
  # shellcheck source=/dev/null
  source "$_f"
done
CR_VERSION="$(cat "$CR_ROOT/VERSION" 2>/dev/null || echo 0.0.0)"
load_config

RUNNERS='herdr|cmux|tmux|headless|command|subagent'
SESSION_RUNNERS='herdr|cmux|tmux'

# ---------------------------------------------------------------- backends

# <runner>:<agent>; old names stay as aliases.
canon_backend() {
  case "$1" in
    codex) echo headless:codex ;;
    herdr-claude) echo herdr:claude ;;
    herdr-codex) echo herdr:codex ;;
    command|subagent) echo "$1" ;;
    *) echo "$1" ;;
  esac
}
backend_runner() { local b; b="$(canon_backend "$(meta "$1" backend)")"; echo "${b%%:*}"; }
backend_agent() { local b; b="$(canon_backend "$(meta "$1" backend)")"; [[ "$b" == *:* ]] && echo "${b#*:}"; return 0; }

valid_backend() {
  local b; b="$(canon_backend "$1")"
  case "$b" in
    command|subagent) return 0 ;;
    *:*) [[ "${b%%:*}" =~ ^($SESSION_RUNNERS|headless)$ && "${b#*:}" =~ ^($KNOWN_AGENTS)$ ]] ;;
    *) return 1 ;;
  esac
}

# Prints why a backend is unavailable here (empty = available); returns 1 when unavailable.
probe_backend() { # <backend>
  local b r a why
  b="$(canon_backend "$1")"; r="${b%%:*}"; a=""; [[ "$b" == *:* ]] && a="${b#*:}"
  if [[ "$r" =~ ^($SESSION_RUNNERS)$ && "${CI:-}" == true ]]; then echo "CI=true: session runners disabled"; return 1; fi
  why="$("${r}_probe" "$a" 2>&1)" || { echo "$why"; return 1; }
  if [[ -n "$a" && "$r" != headless ]]; then
    [[ -n "$(agent_bin "$a")" ]] || { echo "$a not on PATH"; return 1; }
  fi
  return 0
}

steer_mode_of() { local b; b="$(canon_backend "$1")"; "${b%%:*}_steer_mode" "${b#*:}"; }

# Picks the backend to dispatch on. Explicit choices never silently downgrade.
select_backend() { # <id> -> sets SELECTED
  local id="$1" want src b why first="" reasons=()
  want="$(meta "$id" backend)"; src="$(meta "$id" backend_source)"; src="${src:-explicit}"
  CR_TASK_COMMAND="$(meta "$id" command)"
  if [[ -n "$want" && "$src" == explicit ]]; then
    if why="$(probe_backend "$want")"; then SELECTED="$(canon_backend "$want")"; return 0; fi
    local next=""
    for b in $CR_BACKEND_ORDER; do probe_backend "$b" >/dev/null && { next="$b"; break; }; done
    die "backend $want was chosen explicitly but is unavailable: $why${next:+ (next viable: $next; re-create the task with --backend $next, or omit --backend for automatic fallback)}"
  fi
  for b in $CR_BACKEND_ORDER; do
    [[ -z "$first" ]] && first="$b"
    if why="$(probe_backend "$b")"; then
      SELECTED="$(canon_backend "$b")"
      if [[ "$SELECTED" != "$(canon_backend "$first")" ]]; then
        local msg; msg="backend fallback: ${reasons[*]}; using $SELECTED (steering: $(steer_mode_of "$SELECTED"))"
        log_event "$id" note "$msg"; echo "chartroom: $msg" >&2
      fi
      return 0
    fi
    reasons+=("$b unavailable ($why)")
  done
  die "no backend available: ${reasons[*]}. Run 'chartroom doctor'."
}

# ---------------------------------------------------------------- init / project

cmd_init() {
  mkdir -p "$CR_HOME/tasks" "$CR_HOME/worktrees"
  ensure_cursor
  local f t
  # Standing preferences: commander.md (a legacy captain.md is kept and still read).
  [[ -f "$CR_HOME/commander.md" || -f "$CR_HOME/captain.md" ]] || cp "$CR_ROOT/templates/commander.md" "$CR_HOME/commander.md"
  [[ -f "$CR_HOME/projects.md" ]] || cp "$CR_ROOT/templates/projects.md" "$CR_HOME/projects.md"
  [[ -f "$CR_HOME/inbox.md" ]] || cp "$CR_ROOT/templates/inbox.md" "$CR_HOME/inbox.md"
  for f in "$CR_HOME/CLAUDE.md" "$CR_HOME/AGENTS.md"; do
    [[ -f "$f" ]] || cp "$CR_ROOT/templates/home-AGENTS.md" "$f"
  done
  echo "chartroom home ready: $CR_HOME ($CR_HOME_SOURCE)"
  if [[ -z "$CR_PROJECT_ROOTS" ]]; then
    local c found=()
    for c in "$HOME/code" "$HOME/src" "$HOME/work" "$HOME/projects" "$HOME/dev"; do [[ -d "$c" ]] && found+=("$c"); done
    echo "No project roots set, so 'chartroom project <name>' needs a path."
    if [[ ${#found[@]} -gt 0 ]]; then
      echo "To search by name, add to $CR_CONFIG_FILE:"
      echo "  CHARTROOM_PROJECT_ROOTS=$(IFS=:; echo "${found[*]}")"
    fi
  fi
}

cmd_project() {
  [[ $# -ge 1 ]] || die "usage: chartroom project <name-or-path>"
  local q="$1" hits=() p root
  if [[ -d "$q/.git" || -f "$q/.git" ]]; then hits=("$(cd "$q" && pwd)")
  else
    [[ -n "$CR_PROJECT_ROOTS" ]] || die "'$q' is not a repo path and CHARTROOM_PROJECT_ROOTS is unset; pass a path or set roots (see chartroom init)"
    for root in ${CR_PROJECT_ROOTS//:/ }; do
      while IFS= read -r p; do hits+=("$p"); done < <(find "$root" -mindepth 1 -maxdepth 2 -type d -iname "$q" 2>/dev/null)
    done
    if [[ ${#hits[@]} -eq 0 ]]; then
      for root in ${CR_PROJECT_ROOTS//:/ }; do
        while IFS= read -r p; do hits+=("$p"); done < <(find "$root" -mindepth 1 -maxdepth 2 -type d -iname "*$q*" 2>/dev/null)
      done
    fi
  fi
  [[ ${#hits[@]} -gt 0 ]] || die "no project matches '$q' under $CR_PROJECT_ROOTS"
  printf 'name\tpath\tforge\tbase\tregistry\n'
  for p in "${hits[@]}"; do
    [[ -e "$p/.git" ]] || continue
    local url forge base name reg
    name="$(basename "$p")"
    url="$(git -C "$p" remote get-url origin 2>/dev/null || true)"
    case "$url" in
      *github.com*) forge=github ;;
      *gitlab*) forge=gitlab ;;
      *dev.azure.com*|*visualstudio.com*) forge=azure-devops ;;
      "") forge=none ;;
      *) forge=other ;;
    esac
    base="$(git -C "$p" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##' || true)"
    [[ -n "$base" ]] || base="$(git -C "$p" branch --show-current 2>/dev/null || echo main)"
    reg="$(grep -E "^- ${name}:" "$CR_HOME/projects.md" 2>/dev/null | sed -E "s/^- ${name}: *//" || true)"
    printf '%s\t%s\t%s\t%s\t%s\n' "$name" "$p" "$forge" "$base" "${reg:--}"
  done
}

# ---------------------------------------------------------------- new / worktree

cmd_new() {
  local project="" title="" kind="ship" backend="" base="" id="" plan_gate=0 command="" permission="" model=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="$2"; shift 2 ;;
      --title) title="$2"; shift 2 ;;
      --kind) kind="$2"; shift 2 ;;
      --backend) backend="$2"; shift 2 ;;
      --base) base="$2"; shift 2 ;;
      --id) id="$2"; shift 2 ;;
      --command) command="$2"; shift 2 ;;
      --permission) permission="$2"; shift 2 ;;
      --model) model="$2"; shift 2 ;;
      --plan-gate) plan_gate=1; shift ;;
      *) die "new: unknown arg $1" ;;
    esac
  done
  [[ -n "$project" && -n "$title" ]] || die "usage: chartroom new --project PATH --title TEXT [--backend RUNNER:AGENT|command|subagent|auto] [--kind ship|scout] [--base REF] [--plan-gate] [--command TEMPLATE] [--permission MODE] [--model M]"
  [[ "$kind" =~ ^(ship|scout)$ ]] || die "kind must be ship or scout (got $kind)"
  local source=explicit
  if [[ -z "$backend" || "$backend" == auto ]]; then backend=""; source=auto
  else valid_backend "$backend" || die "unknown backend '$backend' (runners: ${RUNNERS//|/, }; agents: ${KNOWN_AGENTS//|/, }; e.g. tmux:claude)"; backend="$(canon_backend "$backend")"; fi
  [[ "$backend" != command || -n "$command" || -n "$CR_COMMAND" ]] || die "the command backend needs --command TEMPLATE or CHARTROOM_COMMAND"
  project="$(cd "$project" 2>/dev/null && pwd)" || die "project path not found"
  git -C "$project" rev-parse --git-dir >/dev/null 2>&1 || die "$project is not a git repo"
  mkdir -p "$CR_HOME/tasks"
  ensure_cursor

  if [[ -z "$base" ]]; then
    base="$(git -C "$project" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || true)"
    if [[ -n "$base" ]]; then git -C "$project" fetch --quiet origin "${base#origin/}" 2>/dev/null || warn "fetch of $base failed; using local ref"
    else base="$(git -C "$project" branch --show-current)"; fi
  fi
  local base_sha
  base_sha="$(git -C "$project" rev-parse --verify --quiet "$base^{commit}")" || die "base ref '$base' not found in $project"

  [[ -n "$id" ]] || id="$(slugify "$title")-$(rand_hex4)"
  [[ "$id" =~ ^[a-z][a-z0-9_-]{0,31}$ ]] || die "id '$id' must match [a-z][a-z0-9_-]{0,31}"
  local d; d="$(tdir "$id")"
  [[ ! -e "$d" ]] || die "task $id already exists"
  mkdir -p "$d"

  local branch=""
  [[ "$kind" == ship ]] && branch="$CR_BRANCH_PREFIX$id"
  jq -n --argjson schema "$CR_SCHEMA" --arg id "$id" --arg title "$title" --arg kind "$kind" --arg backend "$backend" \
    --arg source "$source" --arg project "$project" --arg base "$base" --arg base_sha "$base_sha" --arg branch "$branch" \
    --argjson plan_gate "$plan_gate" --arg command "$command" --arg permission "$permission" --arg model "$model" \
    '{schema:$schema,id:$id,title:$title,kind:$kind,backend:$backend,backend_source:$source,project:$project,base:$base,
      base_sha:$base_sha,branch:$branch,plan_gate:$plan_gate,worktree:"",created:(now|todate),updated:(now|todate)}
     + (if $command != "" then {command:$command} else {} end)
     + (if $permission != "" then {permission:$permission} else {} end)
     + (if $model != "" then {model:$model} else {} end)' >"$d/meta.json"
  : >"$d/events.log"
  log_event "$id" note "created ($kind via ${backend:-auto})"
  write_brief "$id"
  printf 'id=%s\nbrief=%s\n' "$id" "$d/brief.md"
}

write_brief() {
  local id="$1" d kind branch title
  d="$(tdir "$id")"; kind="$(meta "$id" kind)"; branch="$(meta "$id" branch)"; title="$(meta "$id" title)"
  local delivery plan=""
  if [[ "$(meta "$id" plan_gate)" == 1 ]]; then
    plan="
- Plan gate: before changing any project file, investigate, then write \`$d/plan.md\` (approach, files to touch,
  risks, test strategy, open questions). Record a \`decision\` event \"plan ready for approval\" and STOP.
  Build only after the XO relays approval; fold any requested changes into plan.md first."
  fi
  if [[ "$kind" == ship ]]; then
    delivery="Commit your finished work on branch \`$branch\` with conventional-commit messages and leave the worktree clean. Do NOT push, open a pull request, merge, rebase shared branches, or delete branches."
  else
    delivery="This is a scout task: produce knowledge, not code. Do not commit, push, or change project files except throwaway experiments you revert. Your deliverable is the report."
  fi
  cat >"$d/brief.md" <<EOF
# $title

## Commander's intent

<!-- The commander's own words, verbatim. Append later asks here as they arrive. -->

## Spec

<!-- XO: what done looks like, acceptance criteria, non-goals, constraints,
     pointers to relevant files/docs/tickets. Keep it short and concrete. -->

## Authority

- Delivery: $delivery$plan
- Additional grants: none. Anything destructive, irreversible, outward-facing (push, PR, messages, tickets, deploys), or security-sensitive needs a \`decision\` event, not your judgment.

## Worker protocol

You are a crew worker. Your only audience is the XO who wrote this brief; never
address the human directly. Task id: \`$id\`.

1. Work only inside your worktree (your current directory). Never touch the primary checkout
   or other worktrees. Follow the repo's own AGENTS.md / CLAUDE.md conventions.
2. Report status by appending events. Prefer the helper (\`chartroom\` if it is on your PATH):
     CHARTROOM_HOME=$CR_HOME $CR_BIN event $id <kind> "<one line>"
   Fallback if the helper fails:
     printf '%s <kind>: <text>\n' "\$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> $d/events.log
   Kinds: \`progress\` (sparingly, milestones only), \`decision\` (a choice only the human can make:
   state the options and your recommendation, then STOP), \`blocked\` (cannot proceed: say exactly
   what is needed, then STOP), \`done\` (one-line outcome), \`failed\` (could not do it, why),
   \`waiting\` (right before you end a turn to wait on something: CI, a review, a timer, a person.
   Say what, and until when as a UTC time if known, e.g. "CI on PR 12 until 2026-01-05T15:30:00Z".
   When you resume, report again with \`progress\` or any other kind).
3. Before \`done\` or \`failed\`, write $d/report.md containing: outcome; what changed
   (files, commits) or what you found; validation you actually ran with real results (never claim
   a check you did not run); risks and open questions.
4. When you STOP for a decision or blocker, end your turn (or exit, if you are a one-shot
   process). The XO answers in this same session, or by resuming or re-running you
   with the answer as your next prompt. If \`$d/inbox.md\` exists, read it after each milestone.
EOF
}

worktree_path() {
  local id="$1" project name
  project="$(meta "$id" project)"; name="$(basename "$project")"
  if git -C "$project" check-ignore -q .worktrees/probe 2>/dev/null; then
    printf '%s/.worktrees/chartroom_%s' "$project" "$id"
  else
    printf '%s/worktrees/%s/%s' "$CR_HOME" "$name" "$id"
  fi
}

cmd_worktree() {
  local id="${1:-}"; [[ -n "$id" ]] || die "usage: chartroom worktree <id>"; need_task "$id"
  local wt; wt="$(meta "$id" worktree)"
  if [[ -n "$wt" && -d "$wt" ]]; then echo "$wt"; return; fi
  local project base_sha kind branch
  project="$(meta "$id" project)"; base_sha="$(meta "$id" base_sha)"; kind="$(meta "$id" kind)"; branch="$(meta "$id" branch)"
  wt="$(worktree_path "$id")"
  [[ ! -e "$wt" ]] || die "worktree path $wt already exists and is not recorded for $id"
  mkdir -p "$(dirname "$wt")"
  if [[ "$kind" == ship ]]; then
    git -C "$project" worktree add --quiet -b "$branch" "$wt" "$base_sha" >&2
  else
    git -C "$project" worktree add --quiet --detach "$wt" "$base_sha" >&2
  fi
  wt="$(cd "$wt" && pwd -P)"
  meta_set "$id" worktree "$wt"
  # Only a worktree chartroom created itself may have its trust dialog answered automatically.
  meta_set "$id" worktree_created 1
  log_event "$id" note "worktree $wt"
  echo "$wt"
}

# ---------------------------------------------------------------- dispatch

cmd_dispatch() {
  local id="${1:-}"; [[ -n "$id" ]] || die "usage: chartroom dispatch <id>"; need_task "$id"
  local kind wt="" runner agent
  kind="$(meta "$id" kind)"
  grep -qE '^## Spec' "$(tdir "$id")/brief.md" || die "brief is missing its Spec section"
  if ! grep -A3 -E "^## (Commander|Captain)'s intent" "$(tdir "$id")/brief.md" | grep -qvE "^(## |<!--|\s*$)"; then
    die "brief has no commander's intent yet; fill it before dispatch"
  fi
  select_backend "$id"
  meta_set "$id" backend "$SELECTED"
  runner="${SELECTED%%:*}"; agent=""; [[ "$SELECTED" == *:* ]] && agent="${SELECTED#*:}"
  if [[ "$runner" != subagent || "$kind" == ship ]]; then wt="$(cmd_worktree "$id")"; fi
  log_event "$id" note "dispatched via $SELECTED"
  meta_set "$id" dispatched "$(now)"
  "${runner}_launch" "$id" "$wt" "$agent"
  echo "steering: $(steer_mode_of "$SELECTED")"
}

# ---------------------------------------------------------------- event / hook / status / peek

cmd_event() {
  [[ $# -ge 3 ]] || die "usage: chartroom event <id> <kind> <text>"
  local id="$1" kind="$2"; shift 2
  need_task "$id"
  [[ "$kind" =~ ^($EVENT_KINDS)$ ]] || die "event kind must be one of: ${EVENT_KINDS//|/, }"
  log_event "$id" "$kind" "$*"
}

# Agent-native signals -> events. Called by Claude Code hooks (JSON on stdin) and by
# Codex `notify` (JSON as the last argument). Never fails the calling agent.
cmd_hook() {
  local id="${1:-}" what="${2:-}" payload="" msg
  [[ -n "$id" && -f "$(tdir "$id")/meta.json" ]] || exit 0
  case "$what" in
    stop) log_event "$id" agent "turn-ended" ;;
    prompt-submit) log_event "$id" agent "prompt-received" ;;
    notification)
      payload="$(cat 2>/dev/null || true)"
      msg="$(jq -r '.message // empty' <<<"$payload" 2>/dev/null | tr '\n' ' ' | cut -c1-200)"
      log_event "$id" agent "awaiting-input: ${msg:-agent needs input}" ;;
    codex-notify)
      payload="${3:-}"
      printf '%s %s\n' "$(now)" "$payload" >>"$(tdir "$id")/hooks.log"
      case "$(jq -r '.type // empty' <<<"$payload" 2>/dev/null)" in
        agent-turn-complete) log_event "$id" agent "turn-ended" ;;
        "") ;;
        *) log_event "$id" agent "awaiting-input: $(jq -r '.type' <<<"$payload")" ;;
      esac ;;
  esac
  exit 0
}

live_of() { # <id> -> liveness word
  local r; r="$(backend_runner "$1")"
  [[ -n "$r" ]] || { echo not-started; return; }
  CR_TASK_COMMAND="$(meta "$1" command)"
  "${r}_live" "$1" 2>/dev/null || echo unknown
}

state_of() { # derived from the last wake-worthy event; a restart re-derives the same answer
  local id="$1"
  [[ -n "$(meta "$id" closed)" ]] && { echo closed; return; }
  [[ -n "$(meta "$id" dispatched)" ]] || { echo drafting; return; }
  awk '
    ($2=="note:" && $3=="dispatched") || $2=="steered:" { s="working" }
    $2 ~ /^(decision|blocked|done|failed):$/ { k=$2; sub(/:$/, "", k); s=k }
    END { print (s=="" ? "working" : s) }' "$(tdir "$id")/events.log"
}

# One JSON object per line per task: the fleet view that `status` and `dashboard` share.
# last/last_at are the newest non-note event; updated/closed/branch/has_report feed the dashboard.
# A stopped worker whose newest report is `waiting` is "waiting" until its window runs out,
# then "waiting-overdue" (a live one stays "working"). waiting_on/waiting_until/waiting_since
# describe the open `waiting` event whatever the state, and are null without one.
# short_id is the task's short id (short_ids_json), which `resolve` maps back.
status_rows() { # [--all] [--id ID]
  local all=0 only="" id st d live lastline wait shorts
  while [[ $# -gt 0 ]]; do
    case "$1" in --all) all=1; shift ;; --id) only="$2"; all=1; shift 2 ;; *) shift ;; esac
  done
  shorts="$(short_ids_json)"
  shopt -s nullglob
  for d in "$CR_HOME"/tasks/*/; do
    id="$(basename "$d")"; [[ -f "$d/meta.json" ]] || continue
    [[ -z "$only" || "$id" == "$only" ]] || continue
    st="$(state_of "$id")"
    [[ $all -eq 1 || "$st" != closed ]] || continue
    if [[ "$st" == closed ]]; then live=-; else live="$(live_of "$id")"; fi
    wait=""
    [[ "$st" != closed ]] && wait="$(waiting_info "$id" 2>/dev/null || true)"
    if [[ -n "$wait" && "$live" =~ ^(stopped|gone|idle|done)$ ]]; then
      if [[ "$(jq -r .overdue <<<"$wait")" == true ]]; then st="waiting-overdue"; else st="waiting"; fi
    elif [[ -n "$wait" ]]; then st=working
    fi
    [[ "$st" == working && "$live" =~ ^(stopped|gone|idle|done)$ ]] && st="stopped-silent"
    [[ "$st" == working && "$live" == blocked ]] && st="awaiting-input"
    lastline="$(grep -vE ' note: ' "$d/events.log" 2>/dev/null | tail -1 || true)"
    jq -c --arg st "$st" --arg live "$live" --arg last "${lastline:21}" --arg last_at "${lastline:0:20}" \
      --argjson wait "${wait:-null}" --argjson shorts "$shorts" \
      --argjson has_report "$([[ -s "$d/report.md" ]] && echo true || echo false)" \
      '{id,title,kind,backend:(if (.backend//"")=="" then "auto" else .backend end),project:((.project//"")|split("/")|last),
        state:$st,live:$live,created,last:$last,last_at:(if $last_at=="" then null else $last_at end),
        updated,dispatched,closed,branch,has_report:$has_report,
        waiting_on:($wait.on // null),waiting_until:($wait.until // null),waiting_since:($wait.since // null),
        short_id:($shorts[.id] // .id)}' "$d/meta.json"
  done
}

cmd_status() {
  local json=0 all=0 a rows=() row
  for a in "$@"; do case "$a" in --json) json=1 ;; --all) all=1 ;; esac; done
  while IFS= read -r row; do rows+=("$row"); done < <(if [[ $all -eq 1 ]]; then status_rows --all; else status_rows; fi)
  if [[ $json -eq 1 ]]; then printf '%s\n' "${rows[@]+"${rows[@]}"}" | jq -s .; return; fi
  if [[ ${#rows[@]} -eq 0 ]]; then echo "no open tasks"
  else
    printf '%s\n' "${rows[@]}" | jq -r '[.id,.state,.live,.backend,.project,.kind,(.last|.[0:70])] | @tsv' |
      { printf 'ID\tSTATE\tLIVE\tBACKEND\tPROJECT\tKIND\tLAST\n'; cat; } | table
  fi
  inbox_line
}

# One line counting open inbox.md items (bullets under the Waiting / Approvals headings,
# "(none)" excluded); prints nothing when there are none.
inbox_line() {
  local f="$CR_HOME/inbox.md"
  [[ -f "$f" ]] || return 0
  awk -v f="$f" '
    /^## / { s = $0; next }
    /^- / && $0 !~ /^- \(none\)/ { if (s ~ /^## Waiting/) w++; else if (s ~ /^## Approvals/) a++ }
    END {
      if (w + a == 0) exit
      out = ""
      if (w) out = w " waiting on the commander"
      if (a) out = out (out == "" ? "" : ", ") a (a == 1 ? " approval" : " approvals") " not yet in a brief"
      printf "inbox: %s (%s)\n", out, f
    }' "$f"
}

# ---------------------------------------------------------------- inbox ids / resolve

# Inbox items under "## Waiting ..." carry a stable short id as an inline tag right after
# the bullet: "- [i-7f3a] 2026-01-02 — which region?". The tag is written once, when the
# item is created (`inbox add`) or by `inbox tag` for a hand-written line, and never
# changes, so adding or removing other items does not move it.
INBOX_TAG_RE='^\[i-[0-9a-f]{4,}\] '

# Rewrite inbox.md through an awk program (atomic replace). The program gets the tags
# already in the file as `have` ("|i-1a2b|i-3c4d|") so a new one never repeats them.
inbox_rewrite() { # <awk program> [awk -v assignments...]
  local f="$CR_HOME/inbox.md" prog="$1" have; shift
  [[ -f "$f" ]] || die "no inbox at $f (chartroom init)"
  have="|$({ grep -oE '^- \[i-[0-9a-f]{4,}\]' "$f" || true; } | sed -E 's/^- \[(.*)\]$/\1/' | paste -sd'|' -)|"
  awk -v have="$have" -v seed="$RANDOM$$" "$@" '
    function newtag(   t) {
      do t = sprintf("i-%04x", int(rand() * 65536)); while (index(have, "|" t "|"))
      have = have t "|"; return t
    }
    BEGIN { srand(seed) }
    '"$prog" "$f" >"$f.tmp" && mv "$f.tmp" "$f"
}

cmd_inbox() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    tag) # tag every untagged "Waiting" bullet; prints each new id and its line
      local out; out="$(mktemp)"
      inbox_rewrite '
        /^## / { w = ($0 ~ /^## Waiting/) }
        w && /^- / && $0 !~ /^- \(none\)/ && $0 !~ /^- \[i-[0-9a-f]+\] / {
          t = newtag(); sub(/^- /, ""); print "tagged " t ": " $0 > out; $0 = "- [" t "] " $0 }
        { print }' -v out="$out"
      cat "$out"; rm -f "$out"
      ;;
    add) # add <text>: a dated, tagged "Waiting" item at the end of that section; prints its id
      [[ $# -ge 1 && -n "$*" ]] || die "usage: chartroom inbox add <text>"
      local out; out="$(mktemp)"
      INBOX_TEXT="$*" inbox_rewrite '
        function put() { if (!done) { t = newtag(); print "- [" t "] " date " — " ENVIRON["INBOX_TEXT"]; print t > out; done = 1 } }
        function flush() { while (blank > 0) { print ""; blank-- } }
        /^## / { if (w) put(); flush(); w = ($0 ~ /^## Waiting/); seen = seen || w; print; next }
        w && /^- \(none\)/ { next }
        w && /^[[:space:]]*$/ { blank++; next }
        { flush(); print }
        END { if (w) put(); flush(); if (!seen) { print ""; print "## Waiting on the commander"; put() } }' \
        -v date="$(date +%F)" -v out="$out"
      cat "$out"; rm -f "$out"
      ;;
    *) die "usage: chartroom inbox add <text> | inbox tag" ;;
  esac
}

# Map a full or short id back to what it names. Prints the task id, or the inbox tag;
# --json prints the task's status row (type "task") or the inbox item (type "inbox").
# Order: an exact task id; a short id; then a suffix (4+ characters) of exactly one open
# task, else of exactly one closed task. Unknown or ambiguous ids fail and say why.
cmd_resolve() {
  local json=0 q="" a
  for a in "$@"; do case "$a" in --json) json=1 ;; *) q="$a" ;; esac; done
  q="$(tr '[:upper:]' '[:lower:]' <<<"$q" | sed -E 's/^[[:space:]]*\[?//; s/\]?[[:space:]]*$//')"
  [[ -n "$q" ]] || die "usage: chartroom resolve <id|short id> [--json]"
  local item="" task="" shorts
  if [[ "$q" =~ ^i-[0-9a-f]{4,}$ ]]; then
    item="$(dashboard_inbox | jq -c --arg q "$q" '.waiting[] | select(.short_id == $q) | {type: "inbox", id: .short_id, short_id, section: "waiting", date, text}' | head -1)"
  fi
  shorts="$(short_ids_json)"
  if [[ -f "$(tdir "$q")/meta.json" ]]; then task="$q"
  else
    task="$(jq -r --arg q "$q" '[to_entries[] | select(.value == $q) | .key] | if length == 1 then .[0] else empty end' <<<"$shorts")"
    if [[ -z "$task" && ${#q} -ge 4 ]]; then
      local id cands=() ccands=()
      for id in $(jq -r --arg q "$q" 'keys[] | select(endswith($q))' <<<"$shorts"); do
        if [[ -n "$(meta "$id" closed)" ]]; then ccands+=("$id"); else cands+=("$id"); fi
      done
      [[ ${#cands[@]} -eq 0 ]] && cands=("${ccands[@]+"${ccands[@]}"}")
      if [[ ${#cands[@]} -gt 1 ]]; then die "ambiguous id '$q': ${cands[*]}"; fi
      task="${cands[0]-}"
    fi
  fi
  [[ -n "$item" && -n "$task" ]] && die "ambiguous id '$q': inbox item $q and task $task"
  [[ -n "$item" || -n "$task" ]] || die "unknown id '$q' (not a task or an open inbox item)"
  if [[ -n "$item" ]]; then
    if [[ $json -eq 1 ]]; then echo "$item"; else jq -r .id <<<"$item"; fi
  elif [[ $json -eq 1 ]]; then status_rows --id "$task" | jq -c '{type: "task"} + .'
  else echo "$task"; fi
}

table() { if command -v column >/dev/null 2>&1; then column -t -s $'\t'; else cat; fi; }

cmd_peek() {
  local id="${1:-}" n="${2:-15}"; [[ -n "$id" ]] || die "usage: chartroom peek <id> [n]"; need_task "$id"
  local d r; d="$(tdir "$id")"; r="$(backend_runner "$id")"
  echo "== events"; tail -n "$n" "$d/events.log"
  [[ -n "$r" && -n "$(meta "$id" dispatched)" ]] && "${r}_peek" "$id" "$n"
  [[ -f "$d/report.md" ]] && echo "== report: $d/report.md"
  return 0
}

# ---------------------------------------------------------------- steer / stop / close / attach

cmd_steer() {
  local inbox=""
  [[ "${2:-}" == --inbox ]] && { inbox=--inbox; set -- "$1" "${@:3}"; }
  [[ $# -ge 2 ]] || die "usage: chartroom steer <id> [--inbox] <message>"
  local id="$1"; shift; local msg="$*"; need_task "$id"
  [[ -n "$(meta "$id" dispatched)" ]] || die "task $id has not been dispatched"
  local r; r="$(backend_runner "$id")"
  if [[ "$r" == command ]]; then command_steer "$id" "$msg" "$inbox"; else "${r}_steer" "$id" "$msg"; fi
}

cmd_stop() {
  local id="${1:-}"; [[ -n "$id" ]] || die "usage: chartroom stop <id>"; need_task "$id"
  "$(backend_runner "$id")_stop" "$id"
  log_event "$id" note "stopped by XO"
  echo "stopped $id"
}

cmd_attach() {
  local id="${1:-}"; [[ -n "$id" ]] || die "usage: chartroom attach <id>"; need_task "$id"
  "$(backend_runner "$id")_attach" "$id"
}

cmd_close() {
  local id="${1:-}" discard=0; [[ -n "$id" ]] || die "usage: chartroom close <id> [--discard]"; need_task "$id"
  [[ "${2:-}" == --discard ]] && discard=1
  local wt project branch base_sha r
  wt="$(meta "$id" worktree)"; project="$(meta "$id" project)"; branch="$(meta "$id" branch)"; base_sha="$(meta "$id" base_sha)"
  r="$(backend_runner "$id")"
  if [[ -n "$r" && "$r" =~ ^(headless|command)$ ]]; then "${r}_close" "$id"; fi
  if [[ -n "$wt" && -d "$wt" ]]; then
    local dirty; dirty="$(git -C "$wt" status --porcelain)"
    if [[ -n "$dirty" && $discard -eq 0 ]]; then
      printf 'chartroom: refusing to close %s: uncommitted work in %s\n%s\n' "$id" "$wt" "$dirty" >&2
      echo "Only 'chartroom close $id --discard' removes it, and only on the commander's explicit word." >&2
      exit 2
    fi
    if [[ -n "$dirty" ]]; then git -C "$project" worktree remove --force "$wt"; else git -C "$project" worktree remove "$wt"; fi
  fi
  if [[ -n "$branch" ]] && git -C "$project" rev-parse --verify --quiet "$branch" >/dev/null; then
    local ahead; ahead="$(git -C "$project" rev-list --count "$base_sha..$branch")"
    echo "branch $branch kept ($ahead commit(s) ahead of base; branches are never deleted by chartroom)"
  fi
  if [[ -n "$r" && "$r" =~ ^($SESSION_RUNNERS)$ ]]; then "${r}_close" "$id" || true; fi
  meta_set "$id" closed "$(now)"
  if [[ $discard -eq 1 ]]; then log_event "$id" note "closed (uncommitted work discarded on commander's order)"
  else log_event "$id" note "closed"; fi
  echo "closed $id"
}

# ---------------------------------------------------------------- watch

# One stream for the whole fleet. Every stdout line is a wake: a worker
# decision/blocker/done/failure, a process ending, an agent stopping its turn or waiting
# on a prompt, a worker vanishing, or a stopped worker's `waiting` window running out.
# Routine progress, and a turn that ends right after `waiting`, are never printed.
#   chartroom watch                      run forever (e.g. under Claude Code's Monitor)
#   chartroom watch --once [--timeout S] block until the first wake(s), print them, exit 0;
#                                        exit 124 on timeout. Remembers its place in
#                                        $CHARTROOM_HOME/.watch-cursor, so a loop of --once
#                                        calls never misses a wake between calls.
declare -A OFF=() HST=() LOST=()
CURSOR_FILE="$CR_HOME/.watch-cursor"

# The --once cursor is created once, at the current end of every log, so history is
# never replayed; tasks created after that are absent from it and are read from byte 0.
ensure_cursor() {
  [[ -f "$CURSOR_FILE" ]] && return 0
  local d
  shopt -s nullglob
  for d in "$CR_HOME"/tasks/*/; do
    [[ -f "$d/events.log" ]] && printf '%s\t%s\n' "$(basename "$d")" "$(($(wc -c <"$d/events.log")))"
  done >"$CURSOR_FILE"
}
WOKE=0
wake() { printf '[%s] %s\n' "$1" "$2"; WOKE=1; }

watch_scan_lines() { # <id> <from-offset> <to-offset>
  local id="$1" from="$2" to="$3" line kind f pos n
  f="$(tdir "$id")/events.log"; pos="$from"
  while IFS= read -r line; do
    n="$(LC_ALL=C; printf '%s' "${#line}")"; pos=$((pos + n + 1))
    kind="$(line_kind "$line")"
    case "$kind" in
      decision|blocked|done|failed) wake "$id" "$line" ;;
      # A run ending, or a turn stopping, right after the worker reported (or said it is
      # waiting) is not news.
      exited) reported_upto "$id" "$pos" || wake "$id" "$line" ;;
      agent)
        case "$line" in
          *" agent: turn-ended"*) reported_upto "$id" "$pos" || wake "$id" "$line (stopped its turn without reporting)" ;;
          *" agent: awaiting-input"*) wake "$id" "$line" ;;
        esac ;;
    esac
  done < <(head -c "$to" "$f" | tail -c +"$((from + 1))")
}

# reported_since_dispatch, within the first <bytes> of the log.
reported_upto() { # <id> <bytes>
  head -c "$2" "$(tdir "$1")/events.log" | reported_awk
}

# A stopped worker whose waiting window has run out wakes once: the wake is recorded as
# "note: waiting overdue ..." so a restarted or --once watch does not repeat it.
watch_overdue() { # <id>
  local id="$1" wait live
  wait="$(waiting_info "$id" 2>/dev/null || true)"
  [[ -n "$wait" && "$(jq -r '.overdue and (.announced | not)' <<<"$wait")" == true ]] || return 0
  live="$(live_of "$id")"
  [[ "$live" =~ ^(stopped|gone|idle|done)$ ]] || return 0
  local msg; msg="waiting overdue: $(jq -r '"\(.on) (since \(.since)" + (if .until then ", until \(.until)" else "" end) + ")"' <<<"$wait")"
  log_event "$id" note "$msg"
  wake "$id" "$msg"
}

cmd_watch() {
  local once=0 timeout=0 cursor="" a
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --once) once=1; shift ;;
      --timeout) timeout="$2"; shift 2 ;;
      --cursor) cursor="$2"; shift 2 ;;
      *) die "watch: unknown arg $1" ;;
    esac
  done
  shopt -s nullglob
  local d id f size start fresh=1; start="$(date +%s)"
  mkdir -p "$CR_HOME/tasks"
  if [[ $once -eq 1 && -z "$cursor" ]]; then cursor="$CURSOR_FILE"; ensure_cursor; fi
  if [[ -n "$cursor" && -f "$cursor" ]]; then
    fresh=0
    while IFS=$'\t' read -r id a; do [[ -n "$id" ]] && OFF[$id]="$a"; done <"$cursor"
  fi
  for d in "$CR_HOME"/tasks/*/; do
    id="$(basename "$d")"; f="$d/events.log"
    # Streaming without a cursor starts at EOF (status covers anything older).
    [[ $fresh -eq 1 && -f "$f" && -z "${OFF[$id]+x}" ]] && OFF[$id]=$(($(wc -c <"$f")))
    [[ -f "$d/meta.json" && "$(backend_runner "$id" 2>/dev/null)" == herdr ]] && HST[$id]="$(herdr_status "$id" 2>/dev/null || true)"
  done
  while true; do
    for d in "$CR_HOME"/tasks/*/; do
      id="$(basename "$d")"; f="$d/events.log"
      [[ -f "$d/meta.json" && -f "$f" ]] || continue
      [[ -n "$(meta "$id" closed)" ]] && continue
      size=$(($(wc -c <"$f")))
      if (( size > ${OFF[$id]:-0} )); then
        watch_scan_lines "$id" "${OFF[$id]:-0}" "$size"
        OFF[$id]=$size
      fi
      local r; r="$(backend_runner "$id")"
      if [[ -n "$r" && -n "$(meta "$id" dispatched)" ]]; then "${r}_watch" "$id"; watch_overdue "$id"; fi
    done
    if [[ -n "$cursor" ]]; then
      for id in "${!OFF[@]}"; do printf '%s\t%s\n' "$id" "${OFF[$id]}"; done >"$cursor.tmp" && mv "$cursor.tmp" "$cursor"
    fi
    if [[ $once -eq 1 ]]; then
      [[ $WOKE -eq 1 ]] && exit 0
      if (( timeout > 0 && $(date +%s) - start >= timeout )); then echo "chartroom: watch timed out after ${timeout}s with no wakes" >&2; exit 124; fi
    fi
    sleep "$CR_WATCH_INTERVAL"
  done
}

# ---------------------------------------------------------------- doctor / version / install-skills

cmd_doctor() {
  local json=0 ok=1 b why rows=() avail first_ok=""
  [[ "${1:-}" == --json ]] && json=1
  local jqv gitv
  jqv="$(command -v jq >/dev/null && jq --version 2>/dev/null || echo missing)"
  gitv="$(command -v git >/dev/null && git --version 2>/dev/null | awk '{print $3}' || echo missing)"
  [[ "$jqv" == missing || "$gitv" == missing ]] && ok=0
  local all="herdr:claude herdr:codex cmux:claude cmux:codex tmux:claude tmux:codex headless:claude headless:codex command subagent"
  for b in $all; do
    if why="$(probe_backend "$b")"; then avail=yes; why=""; else avail=no; fi
    [[ -z "$first_ok" && "$avail" == yes && " $CR_BACKEND_ORDER " == *" $b "* ]] && first_ok="$b"
    rows+=("$(jq -cn --arg b "$b" --arg a "$avail" --arg w "$why" --arg s "$(steer_mode_of "$b")" '{backend:$b,available:($a=="yes"),steering:$s,reason:$w}')")
  done
  if [[ $json -eq 1 ]]; then
    printf '%s\n' "${rows[@]}" | jq -s --arg v "$CR_VERSION" --arg h "$CR_HOME" --arg hs "$CR_HOME_SOURCE" --arg o "$CR_BACKEND_ORDER" --arg auto "$first_ok" --arg harness "$CR_HARNESS" \
      '{version:$v,home:$h,home_source:$hs,harness:$harness,order:($o|split(" ")),auto:(if $auto=="" then null else $auto end),backends:.}'
  else
    echo "chartroom $CR_VERSION"
    echo "home:     $CR_HOME ($CR_HOME_SOURCE)"
    echo "config:   $CR_CONFIG_FILE$([[ -f "$CR_CONFIG_FILE" ]] || echo ' (not present)')"
    echo "harness:  $CR_HARNESS"
    echo "bash $BASH_VERSION, jq $jqv, git $gitv${CI:+, CI=$CI}"
    echo "order:    $CR_BACKEND_ORDER"
    echo "auto:     ${first_ok:-none available}"
    echo
    printf '%s\n' "${rows[@]}" | jq -r '[.backend, (if .available then "ok" else "-" end), .steering, .reason] | @tsv' |
      { printf 'BACKEND\tOK\tSTEERING\tWHY NOT\n'; cat; } | table
  fi
  [[ $ok -eq 1 ]] || { warn "missing required dependency (jq and git are required)"; return 1; }
}

cmd_version() { echo "chartroom $CR_VERSION (state schema $CR_SCHEMA)"; }

# Link the skills into each agent's user skill directory. Symlinks only; refuses to
# replace anything that is not already a symlink into this checkout.
cmd_install_skills() {
  local targets=() uninstall=0 dry=0 a
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --claude) targets+=("$HOME/.claude/skills") ;;
      --agents|--codex|--gemini) targets+=("$HOME/.agents/skills") ;;
      --pi) targets+=("$HOME/.pi/agent/skills") ;;
      --all) targets+=("$HOME/.claude/skills" "$HOME/.agents/skills" "$HOME/.pi/agent/skills") ;;
      --dir) targets+=("$2"); shift ;;
      --uninstall) uninstall=1 ;;
      --dry-run) dry=1 ;;
      *) die "install-skills: unknown arg $1" ;;
    esac
    shift
  done
  if [[ ${#targets[@]} -eq 0 ]]; then
    [[ -d "$HOME/.claude" ]] && targets+=("$HOME/.claude/skills")
    [[ -d "$HOME/.codex" || -d "$HOME/.agents" || -d "$HOME/.gemini" ]] && targets+=("$HOME/.agents/skills")
    [[ -d "$HOME/.pi" ]] && targets+=("$HOME/.pi/agent/skills")
    [[ ${#targets[@]} -gt 0 ]] || die "no agent config dirs found; pass --claude, --agents, --pi or --dir DIR"
  fi
  local t s src dst cur seen=" "
  for t in "${targets[@]}"; do
    [[ "$seen" == *" $t "* ]] && continue; seen+="$t "
    for s in chartroom bearings dashboard continue captain; do
      src="$CR_ROOT/skills/$s"; dst="$t/$s"
      if [[ $uninstall -eq 1 ]]; then
        if [[ -L "$dst" && "$(realpath_f "$dst")" == "$(realpath_f "$src")" ]]; then
          if [[ $dry -eq 1 ]]; then echo "would remove $dst"; else rm "$dst"; echo "removed $dst"; fi
        elif [[ -e "$dst" || -L "$dst" ]]; then echo "skip $dst (not a chartroom link)"; fi
        continue
      fi
      if [[ -L "$dst" ]]; then
        cur="$(realpath_f "$dst" 2>/dev/null || true)"
        if [[ "$cur" == "$(realpath_f "$src")" ]]; then echo "ok   $dst"; continue; fi
        echo "skip $dst (a symlink to $cur; remove it first)"; continue
      elif [[ -e "$dst" ]]; then echo "skip $dst (exists and is not a symlink; not touching it)"; continue; fi
      if [[ $dry -eq 1 ]]; then echo "would link $dst -> $src"; continue; fi
      mkdir -p "$t"; ln -s "$src" "$dst"; echo "link $dst -> $src"
    done
  done
}

cmd_help() {
  cat <<'EOF'
chartroom - run a crew of coding agents from one agent session (the XO)
(state in $CHARTROOM_HOME, default ~/.chartroom)

  chartroom init                          create the home (commander.md, projects.md, inbox.md, AGENTS.md)
  chartroom doctor [--json]               what can run here: backends, why not, steering mode
  chartroom project <name|path>           resolve a repo: path, forge, default base, overrides
  chartroom new --project P --title T [--backend B] [--kind ship|scout] [--base REF] [--plan-gate]
                [--command TEMPLATE] [--permission MODE] [--model M]
                                          create a task record + brief scaffold. B is
                                          <runner>:<agent> (runners: herdr cmux tmux headless;
                                          agents: claude codex), command, subagent, or auto
                                          (omit --backend: pick per CHARTROOM_BACKEND_ORDER)
  chartroom worktree <id>                 create (or print) the task's isolated worktree
  chartroom dispatch <id>                 launch the worker on its backend
  chartroom steer <id> [--inbox] <msg>    deliver an answer or follow-up to the worker
  chartroom stop <id>                     interrupt a worker
  chartroom attach <id>                   open a session worker's terminal (herdr/cmux/tmux)
  chartroom event <id> <kind> <text>      append a status event (workers use this; kinds: progress,
                                          waiting, decision, blocked, done, failed)
  chartroom status [--json] [--all]       fleet view, derived from disk + live backends
  chartroom board [--json] [--no-color]   the dashboard's lanes in the terminal, one line per
                                          item: short id, title, state, last event
  chartroom resolve <id> [--json]         a full or short id (as the dashboard shows it) -> the
                                          task id, or the inbox item (i-xxxx); fails if unknown
                                          or ambiguous
  chartroom inbox add <text>              add a dated "Waiting on the commander" item with a
                                          stable id; prints the id
  chartroom inbox tag                     give every untagged Waiting item its id (idempotent)
  chartroom rule add --topic T [--supersedes r-x|-] [--src S] <text>
                                          record a lasting commander ruling in rulings.log
                                          (append-only); the newest ruling in a topic wins and
                                          supersedes the previous one; re-renders the generated
                                          block in commander.md (or a legacy captain.md); prints
                                          the id
  chartroom rule retire <r-id> [reason]   end a ruling's topic (appends; nothing is deleted)
  chartroom rule list [--all] [--json]    live rulings, newest first (--all: every ruling,
                                          live ones starred, with supersede links)
  chartroom rule render                   rewrite the generated block from rulings.log
  chartroom rule draft                    print an import map (TSV) of the hand-written
                                          bullets in the preferences file, to edit
  chartroom rule import <map> [--apply]   import a map as rulings: dry run by default; --apply
                                          backs the file up to records/, appends the rulings,
                                          removes the imported bullets and renders the block
  chartroom peek <id> [n]                 recent events and worker output
  chartroom watch [--once [--timeout S]]  wake stream: one line per event that needs the XO
  chartroom dashboard [--port N] [--open] [--daemon] [--no-gh] [--theme chartroom|hud]
                                          local read-only web view (127.0.0.1 only, default
                                          port 4517): needs you / in progress / on hold /
                                          ready / recently finished. Needs python3. The theme
                                          default is CHARTROOM_DASHBOARD_THEME (chartroom).
  chartroom dashboard stop|status|--json  stop a --daemon one, is it up, or print the lanes
  chartroom dashboard open [--port N] [--no-gh] [--theme NAME]
                                          start the dashboard if it is not up (as a daemon),
                                          then open it in the browser (CHARTROOM_OPENER, else
                                          open / xdg-open); prints the URL either way
  chartroom close <id> [--discard]        remove a clean worktree, close its tab, mark closed
                                          (--discard only on the commander's explicit word)
  chartroom install-skills [--claude|--agents|--pi|--all|--dir D] [--uninstall] [--dry-run]
  chartroom version
EOF
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  init|project|new|worktree|dispatch|event|hook|status|board|resolve|inbox|rule|peek|steer|stop|attach|close|watch|dashboard|doctor|version|help) "cmd_$cmd" "$@" ;;
  install-skills) cmd_install_skills "$@" ;;
  ls) cmd_status "$@" ;;
  -h|--help) cmd_help ;;
  -v|--version) cmd_version ;;
  *) die "unknown command '$cmd' (try: chartroom help)" ;;
esac
